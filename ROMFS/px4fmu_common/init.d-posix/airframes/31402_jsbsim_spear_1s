#!/bin/sh
#
# @name spear_1s SITL model for JSBSim
#
# @type Quadrotor x
#
# @maintainer Geunchan Kim
#

. ${R}etc/init.d/rc.mc_defaults

# -------------------------------------------------------
# Control Allocation (CA) - 기체 프레임 및 로터 배치 설정
# -------------------------------------------------------



# Attitude Rate PID tuning (reduced gains to prevent high-frequency oscillations due to low inertia)
param set-default MC_ROLL_P	6.50
param set-default MC_ROLLRATE_K 0.5
param set-default MC_ROLLRATE_P 0.144
param set-default MC_ROLLRATE_I 0.125
param set-default MC_ROLLRATE_D 0.0010

param set-default MC_PITCH_P	6.50
param set-default MC_PITCHRATE_K 1.0
param set-default MC_PITCHRATE_P 0.104
param set-default MC_PITCHRATE_I 0.138
param set-default MC_PITCHRATE_D 0.0008

param set-default MC_YAW_P 4
param set-default MC_YAWRATE_P 0.019
param set-default MC_YAWRATE_I 0.047
param set-default MC_YAWRATE_D 0.0012

# Altitude control damping
param set-default MPC_Z_VEL_P_ACC 4.0
param set-default MPC_Z_VEL_I_ACC 2.0
param set-default MPC_Z_P 1.0

# Flight Mode Parameter
param set-default RC_MAP_FLTMODE 5
param set-default COM_FLTMODE1 0
param set-default COM_FLTMODE2 0
param set-default COM_FLTMODE3 1
param set-default COM_FLTMODE4 1
param set-default COM_FLTMODE5 2
param set-default COM_FLTMODE6 2

# Horizontal cruise speed when auto mode
param set-default MPC_XY_CRUISE 10
param set-default MPC_XY_P 0.7

# param set-default MPC_TILT_MAX_AIR 70
param set-default MPC_TKO_SPEED 3
# param set-default MPC_ACCEL_HOR 10
# param set-default MPC_ACCEL_HOR_MAX 15


# param set-default MPC_CRUISE_90 5

# Bypass waypoint params
param set-default NAV_ACC_RAD 10
# param set-default MPC_JERK_MIN 1
# param set-default MPC_JERK_MAX 1
# param set-default MIS_YAW_ERR 90

##### Frame Params

# CA_AIRFRAME: 기체 프레임 유형 선택
#   0 = 멀티콥터 (Multirotor)
param set-default CA_AIRFRAME 0

# CA_ROTOR_COUNT: 총 로터(모터) 수
param set-default CA_ROTOR_COUNT 4

# --- 로터 0: 우전방 (Front-Right) ---
param set-default CA_ROTOR0_PX 0.1371
param set-default CA_ROTOR0_PY 0.1371
param set-default CA_ROTOR0_KM 0.0206

# --- 로터 1: 좌후방 (Rear-Left) ---
param set-default CA_ROTOR1_PX -0.1371
param set-default CA_ROTOR1_PY -0.1371
param set-default CA_ROTOR1_KM 0.0206

# --- 로터 2: 좌전방 (Front-Left) ---
param set-default CA_ROTOR2_PX 0.1371
param set-default CA_ROTOR2_PY -0.1371
param set-default CA_ROTOR2_KM -0.0206

# --- 로터 3: 우후방 (Rear-Right) ---
param set-default CA_ROTOR3_PX -0.1371
param set-default CA_ROTOR3_PY 0.1371
param set-default CA_ROTOR3_KM -0.0206

# -------------------------------------------------------
# PWM 출력 채널 - 모터 함수 매핑 설정
# -------------------------------------------------------

# PWM_MAIN_FUNC1~4: 각 PWM 출력 채널에 모터 기능 할당
param set-default PWM_MAIN_FUNC1 101
param set-default PWM_MAIN_FUNC2 102
param set-default PWM_MAIN_FUNC3 103
param set-default PWM_MAIN_FUNC4 104
